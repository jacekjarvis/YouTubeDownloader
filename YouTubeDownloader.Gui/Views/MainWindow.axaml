<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YouTubeDownloader.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
        x:Class="YouTubeDownloader.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="720" Height="680" MinWidth="560" MinHeight="520"
        Icon="/Assets/Icon.png"
        Title="Jarvo's YouTube Downloader">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Rotating ring used as a small activity spinner on each row. -->
        <Style Selector="Ellipse.spinner">
            <!-- Percentages = relative to the shape's center; bare numbers would be absolute pixels
                 (which makes it orbit the top-left corner instead of spinning in place). -->
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Small caption above each step. -->
        <Style Selector="TextBlock.step">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="20">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
            <Image Source="/Assets/Icon.png" Width="52" Height="52" VerticalAlignment="Center"/>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="JARVO'S YOUTUBE DOWNLOADER" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Download videos or audio — single clips or whole playlists."
                           Opacity="0.6" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <!-- Step 1: the link. This is the only thing on screen until a fetch succeeds. -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
            <TextBlock Classes="step" Text="STEP 1 — PASTE A LINK"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding Url}"
                         PlaceholderText="Paste a YouTube video or playlist link…"
                         VerticalContentAlignment="Center" IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="1" Content="Fetch" Margin="8,0,0,0" MinWidth="100"
                        Classes="accent" FontWeight="Bold"
                        Command="{Binding FetchCommand}" IsEnabled="{Binding !IsBusy}"
                        HorizontalContentAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Status line: always the last word on what just happened. -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Opacity="0.85"/>

        <!-- Steps 2 and 3: only exist once Fetch has returned videos. Quality sits directly
             beside Download, and Download itself only appears once a quality is chosen. -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="14"
                Background="#11808080" CornerRadius="8"
                IsVisible="{Binding HasVideos}">
            <StackPanel Spacing="12">

                <TextBlock Classes="step" Text="STEP 2 — CHOOSE FORMAT AND WHERE TO SAVE"/>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Classes="fieldLabel" Text="Format:"/>
                    <RadioButton Content="Video (MP4)" GroupName="format" IsChecked="{Binding !IsAudio}"
                                 IsEnabled="{Binding !IsBusy}"/>
                    <RadioButton Content="Audio (MP3)" GroupName="format" IsChecked="{Binding IsAudio}"
                                 IsEnabled="{Binding !IsBusy}"/>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Save to:"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory}" IsReadOnly="True"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0"
                            Click="OnBrowseClick" IsEnabled="{Binding !IsBusy}"/>
                </Grid>

                <Separator Margin="0,2" Opacity="0.25"/>

                <TextBlock Classes="step" Text="STEP 3 — PICK A QUALITY, THEN DOWNLOAD"/>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Quality:"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QualityOptions}"
                              SelectedItem="{Binding SelectedQuality}"
                              PlaceholderText="{Binding QualityPlaceholder}"
                              IsEnabled="{Binding !IsBusy}"/>

                    <!-- Shown only when the quality probe came back empty. -->
                    <Button Grid.Column="2" Content="Retry" Margin="8,0,0,0" MinWidth="80"
                            Command="{Binding ReloadQualitiesCommand}"
                            IsVisible="{Binding ShowQualityRetry}"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="3" Content="Cancel" Margin="8,0,0,0" MinWidth="90"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="4" Content="Download" Margin="8,0,0,0" MinWidth="130"
                            Classes="accent" FontWeight="Bold"
                            Command="{Binding DownloadCommand}"
                            IsVisible="{Binding ShowDownloadButton}"
                            IsEnabled="{Binding !IsBusy}"
                            HorizontalContentAlignment="Center"/>
                </Grid>

                <TextBlock Text="Quality is applied per video; the closest available match is used for each."
                           Opacity="0.6" FontSize="12"
                           IsVisible="{Binding ShowPlaylistProgress}"/>

                <StackPanel Spacing="4" IsVisible="{Binding ShowPlaylistProgress}">
                    <TextBlock Text="Overall progress" FontSize="12" Opacity="0.7"/>
                    <ProgressBar Minimum="0" Maximum="1" Height="10"
                                 Value="{Binding OverallProgress}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results (fills remaining space) -->
        <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="8">
            <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding !HasVideos}">
                    <TextBlock Text="Nothing fetched yet." HorizontalAlignment="Center"
                               Opacity="0.5" FontSize="14"/>
                    <TextBlock Text="Paste a link above and press Fetch — the rest of the options appear then."
                               HorizontalAlignment="Center" Opacity="0.4" FontSize="12"/>
                </StackPanel>
                <ScrollViewer IsVisible="{Binding HasVideos}">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="12,10,12,4"
                              IsVisible="{Binding IsPlaylist}">
                            <TextBlock Grid.Column="0" Text="{Binding PlaylistInfo}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Content="Select all"
                                      IsChecked="{Binding IsSelectAll}"
                                      IsEnabled="{Binding !IsBusy}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Videos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VideoItemViewModel">
                                    <Border Padding="12,8" Margin="6,3"
                                            Background="#0A808080" CornerRadius="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                            <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding ControlsEnabled}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SubTitle}" FontSize="12" Opacity="0.6"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                        Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <!-- Blue spinner while downloading -->
                                                <Ellipse Width="13" Height="13" Classes="spinner"
                                                         Stroke="#4FC3F7" StrokeThickness="2"
                                                         StrokeDashArray="16,6"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding IsDownloading}"/>
                                                <!-- Amber spinner while converting to mp3 -->
                                                <Ellipse Width="13" Height="13" Classes="spinner"
                                                         Stroke="#FFB74D" StrokeThickness="2"
                                                         StrokeDashArray="16,6"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding IsConverting}"/>
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                                           FontSize="12"/>
                                                <Button Content="{Binding PauseButtonText}"
                                                        Command="{Binding TogglePauseCommand}"
                                                        IsVisible="{Binding CanTogglePause}"
                                                        Padding="8,2" FontSize="11"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                         Minimum="0" Maximum="1" Height="6" Margin="0,6,0,0"
                                                         Value="{Binding Progress}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>

    </DockPanel>
</Window>
